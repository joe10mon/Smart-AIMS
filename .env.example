# Copy this file to ".env" and adjust. The real ".env" is git-ignored.
# Real environment variables always override values in this file.

# --- Core ---------------------------------------------------------------
# Generate a new key for any real deployment (this form uses only letters,
# digits, "-" and "_", so it is safe in .env files and in Docker):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-only-change-me-before-deploying
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed behind HTTPS / a reverse proxy, e.g. https://assets.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# --- Database -----------------------------------------------------------
# sqlite (default) or postgres (Docker module; also needs the psycopg package)
DB_ENGINE=sqlite
# SQLITE_PATH=db.sqlite3
# DB_NAME=saims
# DB_USER=saims
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Production switches (see DEPLOYMENT.md) ----------------------------
# Secure cookies + HTTPS detection. Turn on when the site is served over HTTPS.
# DJANGO_HTTPS=True
# Serve static files from the app. docker-compose.yml sets this for you.
# DJANGO_USE_WHITENOISE=True
